<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HafizaAvcisi.MainPage"
    BackgroundColor="#F3E8FF">

    <ScrollView>
        <VerticalStackLayout
            Padding="18,15"
            Spacing="20">

            <!-- Uygulama başlığı -->
            <Label
                Text="Hafıza avcısı"
                FontSize="38"
                FontAttributes="Bold,Italic"
                TextColor="Purple"
                HorizontalOptions="Center" />

            <!-- Üstteki sayaçlar -->
            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="8">

                <!-- Süre -->
                <Border Grid.Column="0"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="8,12">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="⏱ Süre"
                               FontSize="14"
                               TextColor="#8050A0"
                               HorizontalOptions="Center" />
                        <Label x:Name="SureLabel"
                               Text="00:00"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="Purple"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Hamle -->
                <Border Grid.Column="1"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="8,12">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Hamle"
                               FontSize="14"
                               TextColor="#8050A0"
                               HorizontalOptions="Center" />
                        <Label x:Name="HamleLabel"
                               Text="0"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="Purple"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Eşleşme -->
                <Border Grid.Column="2"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="8,12">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Eşleşme"
                               FontSize="14"
                               TextColor="#8050A0"
                               HorizontalOptions="Center" />
                        <Label x:Name="EslesmeLabel"
                               Text="0/10"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="Purple"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Kartların yerleştirileceği alan -->
            <Grid
                x:Name="OyunGrid"
                ColumnDefinitions="*,*,*,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                ColumnSpacing="8"
                RowSpacing="10"
                HorizontalOptions="Fill" />

            <!-- Oyun durumu -->
            <VerticalStackLayout Spacing="8">
                <Label
                    x:Name="DurumLabel"
                    Text="Aynı tatlıları bul ve eşleştir!"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#8050A0"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="IlerlemeLabel"
                    Text="0 / 10 çift tamamlandı"
                    FontSize="14"
                    TextColor="#8050A0"
                    HorizontalOptions="Center" />

                <Label
                    x:Name="EnIyiLabel"
                    Text="En iyi süre: Henüz yok"
                    FontSize="13"
                    TextColor="#8050A0"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Alt butonlar -->
            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12">

                <Button
                    Grid.Column="0"
                    Text="Yeni Oyun"
                    Clicked="YeniOyun_Clicked"
                    BackgroundColor="#9256BF"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50" />

                <Button
                    Grid.Column="1"
                    Text="Sıfırla"
                    Clicked="Sifirla_Clicked"
                    BackgroundColor="White"
                    TextColor="#9256BF"
                    CornerRadius="12"
                    HeightRequest="50" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
